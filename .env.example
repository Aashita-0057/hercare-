# Local development environment (safe to commit — no secrets)
DATABASE_URL="file:./dev.db"

# Session/PIN hashing secret for local dev. REPLACE in production.
APP_SECRET="dev-only-secret-change-me"

# --- External services (leave blank to run in clearly-labelled DEV MODE) ---
# SMS OTP provider (MSG91). When unset, the OTP is shown on screen in DEV MODE.
MSG91_AUTH_KEY=""
MSG91_SMS_FLOW_ID=""
MSG91_SENDER_ID="HERCR+"

# AI assistant backend (OpenAI-compatible). When unset, a rule-based
# knowledge assistant is used and the UI says so.
AI_API_KEY=""
AI_API_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
